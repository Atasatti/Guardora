NODE_ENV=development
PORT=4000
HOST=0.0.0.0
CORS_ORIGINS=http://localhost:3000

MONGO_URI=mongodb://127.0.0.1:27017/guardora
JWT_SECRET_KEY=replace-with-a-long-random-secret
JWT_EXPIRES=30d
AUTH_BYPASS=false

# Local face-recognition service used for banned-person enrollment
AI_SERVICE_URL=http://127.0.0.1:8001
AI_SERVICE_TIMEOUT_MS=10000
AI_LAB_TIMEOUT_MS=180000
AI_SERVICE_API_KEY=replace-with-a-random-service-key
CAMERA_ENCRYPTION_KEY=replace-with-a-separate-32-character-random-key
# Signs the short-lived tokens browsers use to open AI streams. Must match the
# AI service's GUARDORA_AI_STREAM_TOKEN_SECRET, and must differ from
# JWT_SECRET_KEY so the AI service cannot mint user sessions.
AI_STREAM_TOKEN_SECRET=replace-with-another-long-random-secret

# Local, open-source moderation (preferred)
MODERATION_PROVIDER=ollama
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODERATION_MODEL=granite3-guardian:2b
OLLAMA_TIMEOUT_MS=30000

# Optional hosted fallback
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_MAIL=
SMTP_PASSWORD=

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_SUCCESS_URL=
STRIPE_CANCEL_URL=
PAYMENT_CURRENCY=PKR
FRONTEND_URL=http://localhost:3001

# Optional external integrations
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_API_BASE=https://api-m.sandbox.paypal.com
MAPS_API_KEY=
FIREBASE_PROJECT_ID=
RESERVATION_LIFECYCLE_INTERVAL_MS=900000
