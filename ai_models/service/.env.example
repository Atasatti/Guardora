GUARDORA_AI_HOST=127.0.0.1
GUARDORA_AI_PORT=8001
GUARDORA_STREAM_FPS=3
GUARDORA_VIDEO_DIR=../../frontend/public/videos
GUARDORA_FACE_GALLERY=../face_gallery
GUARDORA_FACE_COSINE_THRESHOLD=0.363
GUARDORA_BACKEND_API_URL=http://127.0.0.1:4000/api
GUARDORA_AI_SERVICE_API_KEY=replace-with-the-same-key-as-backend

# The checked-in YOLO models use the AGPL Ultralytics runtime. Keep this false
# unless the deployment is AGPL-compliant or has an Ultralytics enterprise license.
GUARDORA_ALLOW_AGPL_MODELS=false

# Research-only X3D violence checkpoint. Keep disabled outside evaluation.
GUARDORA_ALLOW_RESEARCH_MODELS=false
